{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mazillka/deckyhub-registry/main/registry/apps.schema.json",
  "title": "DeckyHub registry/apps.json, schemaVersion 1",
  "description": "What every released DeckyHub reads. A new key goes in 'properties' (optional only); anything else needs a new schemaVersion. See .agents/skills/compatibility.",
  "type": "object",
  "required": ["schemaVersion", "apps"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "apps": { "type": "array", "items": { "$ref": "#/$defs/app" } }
  },
  "$defs": {
    "stringList": { "type": "array", "items": { "type": "string" } },
    "repo": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "app": {
      "type": "object",
      "required": ["id", "name", "repo", "category", "detect", "asset"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "repo": { "$ref": "#/$defs/repo" },
        "category": { "type": "string", "minLength": 1 },
        "releaseTagInclude": { "type": "string" },
        "detect": {
          "type": "object",
          "required": ["type", "names"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "decky-plugin" },
            "names": { "$ref": "#/$defs/stringList", "minItems": 1 }
          }
        },
        "asset": {
          "type": "object",
          "required": ["include", "exclude"],
          "additionalProperties": false,
          "properties": {
            "include": { "$ref": "#/$defs/stringList", "minItems": 1 },
            "exclude": { "$ref": "#/$defs/stringList" }
          }
        },
        "knownIssues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "url"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string", "minLength": 1, "maxLength": 200 },
              "url": { "type": "string", "pattern": "^https://" }
            }
          }
        },
        "upstream": { "$ref": "#/$defs/repo" },
        "store": { "const": true }
      }
    }
  }
}
